# Frontend build-time config (Vite). Copy to `.env` for local overrides.
# Leave everything unset for zero-config local dev (proxy to :8000, no login).
#
# In CI/GitHub Pages these are injected by the deploy workflow from repo
# Variables, not committed here.

# Absolute backend URL in production (your Cloud Run service). Empty => "/api"
# via the local dev proxy.
VITE_API_BASE_URL=

# OAuth 2.0 Web client id. Setting this ENABLES the login gate.
# MUST match the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Allowed Google Workspace domain.
VITE_ALLOWED_DOMAIN=aprea.com

# Public base path (set by the Pages workflow; usually leave unset locally).
# VITE_BASE=/aprea/searchable-wee1-inhibitor-database/
