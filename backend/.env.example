# Copy to `.env` for local use, or set these as env vars / secrets on Cloud Run.
# Leave everything unset for the zero-config local SQLite + no-auth dev mode.

# --- Auth ---
# Enforce bearer-token access on /api/*. Keep "false" until Microsoft Entra ID is wired.
REQUIRE_AUTH=false

# --- CORS ---
# Comma-separated allowed origins. In production, your GitHub Pages origin:
#   https://omri-shavit.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database ---
# Unset = local SQLite file. For Cloud SQL Postgres over the Cloud Run socket:
#   postgresql+psycopg2://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=
